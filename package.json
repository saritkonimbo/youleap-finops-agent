{
  "name": "youleap-finops-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Internal FinOps copilot for querying Umbrella Cost from Slack",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "umbrella:connect": "tsx src/umbrella/cli.ts connect",
    "umbrella:tools": "tsx src/umbrella/cli.ts tools",
    "umbrella:accounts": "tsx src/umbrella/cli.ts accounts",
    "test": "node --import tsx --test src/umbrella/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@slack/bolt": "^4.4.0",
    "dotenv": "^16.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "type": "module"
}
