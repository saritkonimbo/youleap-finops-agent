{
  "display_information": {
    "name": "YouLeap FinOps Events",
    "description": "Forward private FinOps channel events to n8n",
    "background_color": "#1f2937"
  },
  "features": {
    "bot_user": {
      "display_name": "YouLeap FinOps Events",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["groups:history", "groups:read"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://REPLACE-WITH-N8N-PRODUCTION-WEBHOOK-URL.example/webhook",
      "bot_events": ["message.groups"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
