# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Umbrella Cost
# Never commit real credentials. Exact auth values depend on the enabled Umbrella integration.
UMBRELLA_MCP_URL=https://mcp.umbrellacost.io/mcp
# Private persistent path on the runtime host. Never commit this file.
UMBRELLA_AUTH_FILE=.auth/umbrella.json
UMBRELLA_API_BASE_URL=
UMBRELLA_API_TOKEN=

# Agent
FINOPS_ALLOWED_CHANNEL_IDS=
FINOPS_DEFAULT_CURRENCY=USD
